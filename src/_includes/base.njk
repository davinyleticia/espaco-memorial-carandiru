<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title | safe }} - Dáviny Letícia Vidal</title>
  <link rel="stylesheet" href="/styles.css" />
  
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/_images/inco.png">
  <script src="/pagefind/pagefind-ui.js"></script>

  <meta property="og:title" content="{{ title | safe }} - Dáviny Letícia Vidal" />
  <meta property="og:description" content="Write here..." />
  <meta property="og:url" content="https://github.com/CLCK0622/11ty-Serene" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
  <script src="/main.js"></script>
</head>
<body class="main-body">

  <div class="box nav-box">
    <nav class="nav-bar">
      <div style=" display: flex " class="nav-title"><img style="width: 40px" src="/_images/inco.png" alt="ico" /> Dáviny Letícia Vidal</div>
      <div class="nav-links">
        {% for page in collections.pages %}
          <a href="{{ page.url }}" class="nav-link">{{ page.data.title }}</a>
        {% endfor %} 
        <a href="https://vidal.press//#blog" class="nav-link">Blog</a>
        <a href="https://vidal.press/secao/contents" class="nav-link">Contents</a>
        <a href="https://vidal.press/secao/projects" class="nav-link">Projects</a>
      </div>
      <span class="dark-toggle">
        <span class="material-symbols-outlined">light_mode</span>
        <label class="switch">
          <input type="checkbox" id="darkmode" onclick="change_mode()" aria-labelledby="darkmodelabel" />
          <span class="slider round"></span>
        </label>
        <span class="material-symbols-outlined">dark_mode</span>
      </span>
    </nav>
  </div>

  <div class="box-search nav-box">
    <div class="box" id="search"></div>
  </div>

  <div class="content-wrapper">
    <div class="box" data-pagefind-body>
      {{ content | safe }}
    </div>

    <div class="box footer footer-box">
      <p class="footer-text">© Dáviny Letícia Vidal 🩷 2021 - 2026 - <a href="/policy/">Política Privacidade</a> - hello@vidal.press </p> 
      <p class="footer-text">Built with <a href="https://www.11ty.dev/" class="link" target="_blank">11ty</a>. Powered by <a href="https://netlifycom/" class="link" target="_blank">netlify</a>. - Theme <a href="https://github.com/CLCK0622/11ty-Serene" class="link" target="_blank">11ty-Serene</a>.</p>
    </div>
  </div>

  <script>
    window.addEventListener('DOMContentLoaded', (event) => {
        new PagefindUI({ 
            element: "#search", 
            showImages: false,
            translations: {
                placeholder: "Buscar no site...",
                clear_search: "Limpar",
                load_more: "Ver mais resultados",
                search_label: "Busca",
                filters_label: "Filtros",
                zero_results: "Nenhum resultado encontrado para [SEARCH_TERM]",
                many_results: "[COUNT] resultados encontrados para [SEARCH_TERM]",
                one_result: "[COUNT] resultado encontrado para [SEARCH_TERM]",
                alt_search: "Nenhum resultado para [SEARCH_TERM]. Mostrando resultados para [DIFFERENT_TERM] no lugar.",
                search_suggestion: "Nenhum resultado para [SEARCH_TERM]. Tente um dos seguintes termos:",
                searching: "Buscando por [SEARCH_TERM]..."
            }
        });
    });
  </script>
</body>
</html>